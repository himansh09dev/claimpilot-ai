# ClaimPilot AI — copy to .env.local (git-ignored) and fill in.
# Both variables are SERVER-ONLY (no NEXT_PUBLIC_ prefix), so they never reach the browser.
# Leave them empty to run the portal in "claims API not configured" mode.

# API Gateway stage invoke URL, e.g. https://abc123.execute-api.ap-southeast-2.amazonaws.com/v1
CLAIMS_API_URL=

# API Gateway API key value for the "claimpilot-web-server" key.
# This is not an AWS credential: it only identifies this web server to the usage plan.
CLAIMS_API_KEY=
