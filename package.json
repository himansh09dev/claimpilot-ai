{
  "name": "claimpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ClaimPilot AI — insurance claim verification portal (Phase 1: frontend only)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
